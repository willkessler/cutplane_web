{
  "name": "cutplane-web",
  "private": true,
  "description": "Cutplane / 3Form: a browser-native 3D modeler built around a moving section plane",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cutplane/app dev",
    "build": "pnpm --filter @cutplane/app build",
    "preview": "pnpm --filter @cutplane/app preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "gifenc": "1.0.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
